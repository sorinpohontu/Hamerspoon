--- WindowManager.spoon Configuration File
---
--- Copy this file to config.lua and customize for your needs.
--- Configuration is optional - you can set values programmatically in init.lua as well.

return {
	--- Set to false to load the Spoon without starting it (no hotkeys)
	--- Default: true
	enabled = true,

	--- Logger verbosity: "verbose", "debug", "info", "warning", "error"
	--- Default: "info"
	logLevel = "info",

	--- Show/hide alert messages for window operations
	--- Default: true
	showAlerts = true,

	--- Frame offsets to account for macOS window decorations
	--- Offsets: {x = horizontal gap, y = top offset, h = bottom offset}
	--- Partial tables are merged with the defaults, e.g. {y = 0} keeps x and h
	--- Default: {x = 2, y = 2, h = 6}
	frameOffset = {x = 2, y = 2, h = 6},

	--- Hotkey bindings for window operations
	--- Each action can have a single hotkey or multiple hotkeys
	--- Format for single hotkey: {modifiers, key}
	--- Format for multiple hotkeys: {{modifiers, key}, {modifiers, key}, ...}
	--- Modifiers: "cmd", "alt", "ctrl", "shift"
	---
	--- Available actions:
	---   center - Center window on screen
	---   topRight - Move window to top right corner
	---   halfLeft - Move window to left half of screen
	---   halfRight - Move window to right half of screen
	---   fullDesktop - Resize window to fill entire screen
	---
	--- Default hotkeys shown below
	hotkeys = {
		center = {{{"cmd", "alt", "ctrl"}, "C"}, {nil, "F16"}},  -- Two hotkeys for center
		topRight = {{"cmd", "shift"}, "T"},
		halfLeft = {{"cmd", "shift"}, "["},
		halfRight = {{"cmd", "shift"}, "]"},
		fullDesktop = {{{"cmd", "shift"}, "0"}, {nil, "F13"}},  -- Two hotkeys for fullDesktop
	},
}

---
--- CONFIGURATION EXAMPLES
---

